{
	"name": "@career-group/frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env NODE_ENV=development node ./bin/build.js",
		"build": "cross-env NODE_ENV=production node ./bin/build.js",
		"check": "tsc --noEmit",
		"lint": "eslint ./pages ./shared && prettier --check ./pages ./shared ./bin",
		"lint:fix": "eslint ./pages ./shared --fix && prettier --write ./pages ./shared ./bin"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.4",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"prettier": "^3.6.2",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.46.4"
	}
}
