{
	"name": "@career-group/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx src/node.ts",
		"build": "tsc --noEmit",
		"deploy": "vercel deploy --prod",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint ./src && prettier --check ./src",
		"lint:fix": "eslint ./src --fix && prettier --write ./src",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@hono/node-server": "^1.19.9",
		"@types/node": "^22.19.1",
		"dotenv": "^18.0.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.46.4",
		"vercel": "^48.1.6",
		"vitest": "~3.2.0"
	},
	"dependencies": {
		"hono": "^4.13.8",
		"zod": "^4.6.5"
	}
}
