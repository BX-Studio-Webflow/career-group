# Bullhorn API user. The browser never sees these.
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_API_USERNAME=
BULLHORN_API_PASSWORD=

# JobSubmission status from the Client's existing picklist. WordPress used Web Response.
BULLHORN_SUBMISSION_STATUS=Web Response

# Set only if creating a Candidate requires a status picklist value.
BULLHORN_CANDIDATE_STATUS=

# Comma-separated Webflow origins, or * for local development.
CORS_ORIGINS=*
